# ─────────────────────────────────────────────────────────────────────────────
# وصفاتنا — production image (serversideup/php + S6 Overlay v3).
# Build: docker build -t wasfatna . — see docs/guides/deployment-and-updates.md
# ─────────────────────────────────────────────────────────────────────────────

# Stage 1: client + SSR bundles (vite build && vite build --ssr)
FROM oven/bun:1 AS frontend-builder
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
# The Ziggy route list is generated by PHP at runtime (@routes), not at build time.
RUN bun run build

# Stage 1b: production node_modules for the SSR runtime (only used when
# INERTIA_SSR_ENABLED=true; the SSR bundle imports its deps from node_modules).
FROM oven/bun:1 AS ssr-deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

# Stage 2: runtime
FROM serversideup/php:8.4-fpm-nginx

ENV PHP_FPM_PM=ondemand \
    PHP_FPM_PM_MAX_CHILDREN=30 \
    PHP_FPM_REQUEST_TERMINATE_TIMEOUT=60s \
    PHP_OPCACHE_ENABLE=1 \
    PHP_POST_MAX_SIZE=24M \
    PHP_UPLOAD_MAX_FILE_SIZE=20M \
    NGINX_CLIENT_MAX_BODY_SIZE=24M \
    NGINX_FASTCGI_READ_TIMEOUT=65s \
    NGINX_WEBROOT=/var/www/html/public \
    INERTIA_SSR_ENABLED=true

USER root

# mariadb-client: mysqldump for manual/automated backups from inside the container.
RUN apt-get update && apt-get install -y --no-install-recommends curl mariadb-client \
    && rm -rf /var/lib/apt/lists/*

# gd: Intervention Image (GD driver) encodes uploads to WebP.
# exif: reads photo orientation. intl: Laravel number/locale helpers.
RUN install-php-extensions gd exif intl

# Node runs the optional Inertia SSR server (docker/s6/inertia-ssr-run).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

COPY --chown=www-data:www-data . .
COPY --from=frontend-builder --chown=www-data:www-data /app/public/build ./public/build
COPY --from=frontend-builder --chown=www-data:www-data /app/bootstrap/ssr ./bootstrap/ssr
COPY --from=ssr-deps --chown=www-data:www-data /app/node_modules ./node_modules

RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-scripts \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY docker/10-startup.sh /etc/entrypoint.d/10-startup.sh
RUN chmod +x /etc/entrypoint.d/10-startup.sh

# Long-running services managed by S6: queue worker, scheduler, optional SSR.
RUN for svc in queue-worker laravel-scheduler inertia-ssr; do \
        mkdir -p /etc/s6-overlay/s6-rc.d/$svc/dependencies.d; \
        echo longrun > /etc/s6-overlay/s6-rc.d/$svc/type; \
    done
COPY docker/s6/queue-worker-run /etc/s6-overlay/s6-rc.d/queue-worker/run
COPY docker/s6/laravel-scheduler-run /etc/s6-overlay/s6-rc.d/laravel-scheduler/run
COPY docker/s6/inertia-ssr-run /etc/s6-overlay/s6-rc.d/inertia-ssr/run
RUN chmod +x /etc/s6-overlay/s6-rc.d/*/run \
    && S6_USER_BUNDLE=/etc/s6-overlay/user-bundles.d/user; \
    [ -d "$S6_USER_BUNDLE/contents.d" ] || S6_USER_BUNDLE=/etc/s6-overlay/s6-rc.d/user; \
    touch "$S6_USER_BUNDLE/contents.d/queue-worker" \
          "$S6_USER_BUNDLE/contents.d/laravel-scheduler" \
          "$S6_USER_BUNDLE/contents.d/inertia-ssr"

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8080/up || exit 1

USER www-data
EXPOSE 8080
