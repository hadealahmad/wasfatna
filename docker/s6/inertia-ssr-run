#!/bin/sh
# Inertia SSR render server. The image defaults INERTIA_SSR_ENABLED=true; set it
# to false to idle this service (Laravel then stops calling the SSR server too).
if [ "${INERTIA_SSR_ENABLED}" != "true" ]; then
    echo "Inertia SSR disabled; idling."
    exec sleep infinity
fi
echo "Starting Inertia SSR server..."
exec node /var/www/html/bootstrap/ssr/ssr.js
